# This is a curated desktop repository living inside an older dotfiles folder.
# Ignore everything unless explicitly included below.
*

!/.gitignore
!/README.md
!/setup.sh

!/niri/
!/niri/*.kdl

!/waybar/
!/waybar/config.jsonc
!/waybar/style.css
!/waybar/power_menu.xml

!/fuzzel/
!/fuzzel/fuzzel.ini
!/fuzzel/dank-colors.ini

!/matugen/
!/matugen/config.toml
!/matugen/templates/
!/matugen/templates/fuzzel.ini

!/dms/
!/dms/niri-blue.json
!/dms/settings.json.template
!/dms/session.json.template

!/desktop-config/
!/desktop-config/xfce4-terminal.xml
!/desktop-config/ibus.dconf
!/desktop-config/gtk-3.0/
!/desktop-config/gtk-3.0/gtk.css
!/desktop-config/gtk-3.0/settings.ini
!/desktop-config/gtk-4.0/
!/desktop-config/gtk-4.0/settings.ini
!/desktop-config/fontconfig/
!/desktop-config/fontconfig/20-no-embedded.conf
!/desktop-config/ibus-bamboo/
!/desktop-config/ibus-bamboo/ibus-bamboo.config.json
!/desktop-config/ibus-bamboo/ibus-bamboo.macro.text
!/desktop-config/ibus-bamboo/ibus-bamboous.macro.text

!/sessions/
!/sessions/niri-dms.desktop
!/sessions/niri-session-dms

!/system/
!/system/keyd/
!/system/keyd/default.conf

!/wallpapers/
!/wallpapers/wall-2.png

# DMS regenerates these inside the linked Niri directory.
/niri/dms/
